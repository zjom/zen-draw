{
  "private": true,
  "name": "excalidraw-monorepo",
  "packageManager": "pnpm@12.9.0",
  "devDependencies": {
    "@babel/preset-env": "7.26.9",
    "@excalidraw/eslint-config": "1.0.3",
    "@excalidraw/prettier-config": "1.0.2",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@types/chai": "4.3.0",
    "@types/jest": "27.4.0",
    "@types/lodash.throttle": "4.1.7",
    "@types/node": "26.6.5",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/socket.io-client": "3.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "chai": "4.3.6",
    "dotenv": "16.0.1",
    "ejs": "7.0.2",
    "esbuild": "0.19.10",
    "esbuild-sass-plugin": "2.16.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-config-react-app": "7.0.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "3.3.1",
    "fake-indexeddb": "3.1.7",
    "fonteditor-core": "2.4.1",
    "http-server": "14.1.1",
    "husky": "7.0.4",
    "jsdom": "22.1.0",
    "lint-staged": "12.3.7",
    "pepjs": "0.5.3",
    "prettier": "2.6.2",
    "rewire": "6.0.0",
    "rimraf": "^5.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "8.3.5",
    "vite-plugin-checker": "0.14.5",
    "vite-plugin-ejs": "2.0.0",
    "vite-plugin-pwa": "2.0.0",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "5.0.5",
    "vitest-canvas-mock": "1.2.0",
    "wawoff2": "2.0.1",
    "which": "4.0.0"
  },
  "engines": {
    "node": ">=26"
  },
  "homepage": ".",
  "prettier": "@excalidraw/prettier-config",
  "scripts": {
    "build-node": "node ./scripts/build-node.js",
    "build:app": "pnpm --dir ./excalidraw-app run build:app",
    "build:common": "pnpm --dir ./packages/common run build:esm",
    "build:element": "pnpm --dir ./packages/element run build:esm",
    "build:excalidraw": "pnpm --dir ./packages/excalidraw run build:esm",
    "build:math": "pnpm --dir ./packages/math run build:esm",
    "build:fractional-indexing": "pnpm --dir ./packages/fractional-indexing run build:esm",
    "build:laser-pointer": "pnpm --dir ./packages/laser-pointer run build:esm",
    "build:packages": "pnpm run build:common && pnpm run build:fractional-indexing && pnpm run build:laser-pointer && pnpm run build:math && pnpm run build:element && pnpm run build:excalidraw",
    "build:version": "pnpm --dir ./excalidraw-app run build:version",
    "build": "pnpm --dir ./excalidraw-app run build",
    "build:preview": "pnpm --dir ./excalidraw-app run build:preview",
    "start": "pnpm --dir ./excalidraw-app run start",
    "start:production": "pnpm --dir ./excalidraw-app run start:production",
    "start:example": "pnpm run build:packages && pnpm --dir ./examples/with-script-in-browser run start",
    "zen-draw:dev": "pnpm --dir ./zen-draw run tauri dev",
    "zen-draw:build": "pnpm --dir ./zen-draw run tauri build",
    "test:all": "pnpm run test:typecheck && pnpm run test:code && pnpm run test:other && pnpm run test:app --watch=false",
    "test:app": "vitest",
    "test:code": "eslint --max-warnings=0 --ext .js,.ts,.tsx .",
    "test:other": "pnpm run prettier --list-different",
    "test:typecheck": "tsc && pnpm --dir ./zen-draw exec tsc",
    "test:update": "pnpm run test:app --update --watch=false",
    "test": "pnpm run test:app",
    "test:coverage": "vitest --coverage",
    "test:coverage:watch": "vitest --coverage --watch",
    "test:ui": "pnpm run test --ui --coverage.enabled=true",
    "fix:code": "pnpm run test:code --fix",
    "fix:other": "pnpm run prettier --write",
    "fix": "pnpm run fix:other && pnpm run fix:code",
    "locales-coverage": "node scripts/build-locales-coverage.js",
    "locales-coverage:description": "node scripts/locales-coverage-description.js",
    "prepare": "husky install",
    "prettier": "prettier \"**/*.{css,scss,json,md,html,yml}\" --ignore-path=.eslintignore",
    "rm:build": "rimraf --glob excalidraw-app/build excalidraw-app/dist excalidraw-app/dev-dist packages/*/dist packages/*/build examples/*/build examples/*/dist zen-draw/dist",
    "rm:node_modules": "rimraf --glob node_modules excalidraw-app/node_modules packages/*/node_modules examples/*/node_modules zen-draw/node_modules",
    "clean-install": "pnpm run rm:node_modules && pnpm install"
  }
}
