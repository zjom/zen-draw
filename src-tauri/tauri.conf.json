{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "simple-whiteboard",
  "version": "0.1.0",
  "identifier": "com.zjom.simple-whiteboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "simple-whiteboard",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["tldr"],
        "name": "tldraw document",
        "mimeType": "application/vnd.tldraw+json",
        "role": "Editor"
      }
    ]
  }
}
